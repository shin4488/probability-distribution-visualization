{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/codex-hook.py\" biome-fix.sh",
            "timeout": 90,
            "statusMessage": "Biomeでlint+formatを適用中..."
          }
        ]
      }
    ]
  }
}
